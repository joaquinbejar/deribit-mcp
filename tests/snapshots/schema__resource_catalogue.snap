---
source: tests/schema.rs
expression: "serde_json::json!({ \"resources\": entries, \"templates\": templates, })"
---
resources:
  - description: Static list of Deribit currency symbols and metadata.
    mimeType: application/json
    name: Deribit currency catalogue
    uri: "deribit://currencies"
templates:
  - description: "Order book snapshots from the `book.<instrument>.raw` channel. Read returns the latest decoded BookSnapshot when a SubscriptionProvider is configured; otherwise AdapterError::Internal."
    mimeType: application/json
    name: Deribit order book (live)
    uriTemplate: "deribit://book/{instrument}"
  - description: Static list of instruments for a given currency.
    mimeType: application/json
    name: Deribit instruments by currency
    uriTemplate: "deribit://instruments/{currency}"
  - description: "Throttled ticker snapshots from the `ticker.<instrument>.100ms` channel. Read returns the latest TickerSnapshot when a SubscriptionProvider is configured; otherwise AdapterError::Internal."
    mimeType: application/json
    name: Deribit ticker (live)
    uriTemplate: "deribit://ticker/{instrument}"
  - description: "Trade events from the `trades.<instrument>.raw` channel. Read returns the most recent N TradeUpdate values (newest first) when a SubscriptionProvider is configured; otherwise AdapterError::Internal."
    mimeType: application/json
    name: Deribit last trades (live)
    uriTemplate: "deribit://trades/{instrument}"
