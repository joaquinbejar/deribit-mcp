# Reference environment for `deribit-mcp`. Credentials are env-only
# — there is no CLI flag for `client_secret` or
# `http_bearer_token`. Copy this file to `.env`, fill in the values,
# and `docker compose up -d`. `.gitignore` excludes `.env*` with
# `!.env.example` allow-listed, so a populated `.env` never lands
# in version control.

# ---------- Network selection
# `testnet` (default) or `mainnet`. Resolves to the documented
# Deribit endpoints (https://test.deribit.com /
# https://www.deribit.com). Use `DERIBIT_ENDPOINT=<full URL>` for
# proxies / forks. `--testnet` / `--mainnet` CLI flags still win
# if both are passed.
DERIBIT_NETWORK=testnet

# ---------- Deribit OAuth credentials (required for Account /
# Trading tools; v0.1 public Read tools work without them). Issue
# them via the Deribit web console under Account → API.

DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=

# ---------- HTTP transport (optional)
# Static bearer token gating the `/mcp` endpoint. When set, every
# request must carry `Authorization: Bearer <DERIBIT_HTTP_BEARER_TOKEN>`.
# `/healthz` is always anonymous.
DERIBIT_HTTP_BEARER_TOKEN=

# ---------- Logging (optional)
# `RUST_LOG` honours the standard `tracing-subscriber` filter syntax.
# stdio mode logs text to stderr; HTTP mode logs JSON to stdout.
RUST_LOG=info,deribit_mcp=debug
